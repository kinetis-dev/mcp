{
    "name": "kinetis/mcp",
    "description": "The Model Context Protocol server for Kinetis — tools and resources declared with attributes and validated like HTTP routes, served over stdio and as an ordinary /mcp route.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "kinetis/framework": "dev-main",
        "nyholm/psr7": "^1.8.2",
        "psr/container": "^2.0.2",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0.2",
        "psr/log": "^3.0.2"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "kinetis/auth": "dev-main",
        "kinetis/persistence": "dev-main",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^12.5.33",
        "vimeo/psalm": "^6.16.1"
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\Mcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\Mcp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "kinetis": {
            "scan": "Kinetis\\Mcp\\",
            "bootstrap": "Kinetis\\Mcp\\PackageBootstrap"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../auth"
        },
        {
            "type": "path",
            "url": "../persistence"
        },
        {
            "type": "path",
            "url": "../framework"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
